{
  "name": "code-architecture-analyzer",
  "version": "7.1.0",
  "description": "Deep Python architecture analysis with automatic refactoring — 51 criteria (SOLID, anti-patterns, LLM-aware, Django-Aware, Security, FeatureEnvy, ShotgunSurgery, LSP, UselessListComp), Intent Learning (learns from your feedback), Agent Review (metacognitive prompts for AI agents with 20 design patterns), --agent mode for AI coding agents, accuracy harness (recall/precision corpus), i18n pt/en, HTML dashboard auto-generated, ruff-powered (no pylint), criteria cache. Pre-commit gate. 340 tests.",
  "main": "index.js",
  "bin": {
    "code-analyze": "bin/cli.js"
  },
  "scripts": {
    "start": "python bin/cli.py",
    "analyze": "python bin/cli.py",
    "setup": "python bin/cli.py setup"
  },
  "keywords": [
    "python",
    "architecture",
    "analysis",
    "refactoring",
    "solid",
    "design-patterns",
    "code-quality",
    "ast",
    "ruff",
    "risk-score",
    "git-patch",
    "semantic-duplication",
    "lazy-evaluation",
    "llm-aware",
    "intent-learning",
    "test-pain",
    "mock-density",
    "test-coverage",
    "test-isolation",
    "i18n",
    "agent-review",
    "metacognitive",
    "ai-agents"
  ],
  "author": "Sergio MT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioMT88/code-architecture-analyzer-.git"
  },
  "homepage": "https://github.com/SergioMT88/code-architecture-analyzer-",
  "bugs": {
    "url": "https://github.com/SergioMT88/code-architecture-analyzer-/issues"
  },
  "engines": {
    "node": ">=14.0.0",
    "python": ">=3.8"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ora": "^5.4.1"
  },
  "files": [
    "bin/cli.py",
    "bin/cli.js",
    "lib/python-utils.js",
    "src/code_analyzer/*.py",
    "src/code_analyzer/analyzer/*.py",
    "src/code_analyzer/analyzer/detectors/*.py",
    "pyproject.toml",
    "index.js",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    ".pre-commit-hooks.yaml"
  ]
}

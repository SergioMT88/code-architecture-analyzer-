{
  "name": "code-architecture-analyzer",
  "version": "2.1.7",
  "description": "Deep Python architecture analysis with automatic refactoring. Detects 34 criteria: SOLID violations, God Classes, anti-patterns, LLM error patterns. Findings with exact line numbers, dry-run mode, interactive mode, project config.",
  "main": "index.js",
  "bin": {
    "code-analyze": "bin/cli.js"
  },
  "scripts": {
    "start": "python bin/cli.py",
    "analyze": "python bin/cli.py",
    "setup": "python bin/cli.py setup"
  },
  "keywords": [
    "python",
    "architecture",
    "analysis",
    "refactoring",
    "solid",
    "design-patterns",
    "code-quality",
    "ast",
    "pylint",
    "ruff"
  ],
  "author": "Sergio MT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioMT88/code-architecture-analyzer-.git"
  },
  "homepage": "https://github.com/SergioMT88/code-architecture-analyzer-",
  "bugs": {
    "url": "https://github.com/SergioMT88/code-architecture-analyzer-/issues"
  },
  "engines": {
    "node": ">=14.0.0",
    "python": ">=3.8"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ora": "^5.4.1"
  },
  "files": [
    "bin/cli.py",
    "bin/cli.js",
    "lib/python-utils.js",
    "src/",
    "pyproject.toml",
    "index.js",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ]
}

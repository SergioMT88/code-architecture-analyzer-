{
  "name": "code-architecture-analyzer",
  "version": "7.6.0",
  "description": "Deep Python architecture analysis with automatic refactoring. Visible semantic analysis: intra-file taint (incl. class methods) + dataflow + purity, surfaced in the agent envelope (schema 1.1). Cross-file detection: TaintFlow, GodClassCrossFile, ShotgunSurgery, CloneDetection, HighFanIn. Unified --agent JSON (metacognitive + diffs + semantic + Intent Learning). 52 criteria, 20 design patterns, i18n pt/en, HTML dashboard. 404 tests, 0 ruff errors, 68% coverage.",
  "main": "index.js",
  "bin": {
    "code-analyze": "bin/cli.js"
  },
  "scripts": {
    "start": "python bin/cli.py",
    "analyze": "python bin/cli.py",
    "setup": "python bin/cli.py setup"
  },
  "keywords": [
    "python",
    "architecture",
    "analysis",
    "refactoring",
    "solid",
    "design-patterns",
    "code-quality",
    "ast",
    "ruff",
    "risk-score",
    "git-patch",
    "semantic-duplication",
    "lazy-evaluation",
    "llm-aware",
    "intent-learning",
    "test-pain",
    "mock-density",
    "test-coverage",
    "test-isolation",
    "i18n",
    "agent-review",
    "metacognitive",
    "ai-agents"
  ],
  "author": "Sergio MT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioMT88/code-architecture-analyzer-.git"
  },
  "homepage": "https://github.com/SergioMT88/code-architecture-analyzer-",
  "bugs": {
    "url": "https://github.com/SergioMT88/code-architecture-analyzer-/issues"
  },
  "engines": {
    "node": ">=14.0.0",
    "python": ">=3.8"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ora": "^5.4.1"
  },
  "files": [
    "bin/cli.py",
    "bin/cli.js",
    "lib/python-utils.js",
    "src/code_analyzer/*.py",
    "src/code_analyzer/analyzer/*.py",
    "src/code_analyzer/analyzer/detectors/*.py",
    "src/code_analyzer/patterns/*.py",
    "src/code_analyzer/reporting/*.py",
    "pyproject.toml",
    "index.js",
    "SKILL.md",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".pre-commit-hooks.yaml"
  ]
}
